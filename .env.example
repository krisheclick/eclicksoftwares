# Existing public CMS configuration (use your deployment's current values).
NEXT_PUBLIC_API_URL=https://admin.eclicksoftwares.com/api/v1/
NEXT_PUBLIC_MEDIA_URL=https://admin.eclicksoftwares.com/
NEXT_PUBLIC_ENV_URL=http://localhost:3000
NEXT_PUBLIC_assetPrefix=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Server only. Never prefix these keys/tokens with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CHATBOT_ENABLED=true
CHATBOT_MAX_OUTPUT_TOKENS=1024
CHATBOT_RATE_LIMIT=20
CHATBOT_WELCOME_DELAY=5000
CHATBOT_NOTIFICATION_EMAIL=
# Escape dollar signs in .env files because Next.js expands variable references.
CHATBOT_BUDGET_RANGES=Under \$500|\$500–\$1,000|\$1,000–\$3,000|\$3,000–\$5,000|\$5,000–\$10,000|Above \$10,000|Not Decided Yet

# Optional dedicated chatbot adapter. Leave blank to reuse the website's
# existing NEXT_PUBLIC_API_URL + schedule-a-call endpoint and Let's Connect form.
# Set these only after the CMS implements the dedicated receipt contract.
CHATBOT_ENQUIRY_API_URL=
CHATBOT_BACKEND_TOKEN=
# true only behind a proxy that replaces untrusted X-Forwarded-For headers.
CHATBOT_TRUST_PROXY=false
# Retention and notification settings must be implemented by the CMS backend;
# the Next.js adapter does not operate deletion jobs or send mail itself.
CHATBOT_SESSION_RETENTION_DAYS=7
CHATBOT_LEAD_RETENTION_DAYS=365
